PORT=3001

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Gemini (motor del agente)
GEMINI_API_KEY=AIza...

# GitHub (fine-grained token con permiso de lectura en Pull requests)
GITHUB_TOKEN=

# Resend (recordatorios por email)
RESEND_API_KEY=
REMINDER_EMAIL=tu-email@ejemplo.com
# Opcional, por defecto usa la direccion de pruebas de Resend
RESEND_FROM_ADDRESS=

# Autenticacion: cualquier cadena larga y aleatoria sirve. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opcional: restringe CORS al dominio de tu frontend desplegado (ej. Vercel)
FRONTEND_URL=
